<% var pf = theme.profile || {}; %>
<div class="box w-profile"><div class="boxt">◆ 站长档案</div><div class="boxb">
  <table width="100%" cellspacing="0" cellpadding="0" border="0"><tr>
    <td width="54" valign="top">
      <% if (pf.avatar) { %>
      <img class="avatar" src="<%- url_for(pf.avatar) %>" width="48" height="48" alt="<%= pf.nickname %>">
      <% } else { %>
      <svg class="avatar" width="48" height="48" viewBox="0 0 12 12" shape-rendering="crispEdges" aria-hidden="true">
        <rect width="12" height="12" fill="#336699"/>
        <rect x="3" y="1" width="6" height="2" fill="#332211"/><rect x="2" y="2" width="1" height="5" fill="#332211"/><rect x="9" y="2" width="1" height="5" fill="#332211"/>
        <rect x="3" y="3" width="6" height="5" fill="#FFCC99"/><rect x="3" y="3" width="6" height="1" fill="#332211"/>
        <rect x="4" y="5" width="1" height="1" fill="#000"/><rect x="7" y="5" width="1" height="1" fill="#000"/>
        <rect x="5" y="7" width="2" height="1" fill="#CC3333"/>
        <rect x="3" y="8" width="6" height="4" fill="#FF6699"/><rect x="5" y="9" width="2" height="1" fill="#FFFFFF"/>
      </svg>
      <% } %>
    </td>
    <td valign="top">
      昵称：<span class="hi3"><%= pf.nickname || config.author %></span><br>
      <% if (pf.items) { Object.keys(pf.items).forEach(function (k) { %><%= k %>：<%= pf.items[k] %><br><% }) } %>
    </td>
  </tr></table>
  <% if (pf.oicq || pf.email) { %>
  <div class="w-profile-contact">
    <% if (pf.oicq) { %>OICQ：<span class="hi2"><%= pf.oicq %></span><br><% } %>
    <% if (pf.email) { %>E-mail：<a href="mailto:<%= pf.email %>"><%= pf.email %></a><% } %>
  </div>
  <% } %>
</div></div>
