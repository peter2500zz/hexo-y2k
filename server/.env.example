# 复制为 .env 后修改：cp .env.example .env

# 宿主机上监听的端口（只绑 127.0.0.1，由 nginx 反代过来）
Y2K_PORT=8787

# 管理后台 /admin 的口令，留空则关闭后台。可用 openssl rand -hex 24 生成
ADMIN_TOKEN=

# 博客地址，后台里的文章链接、新留言通知、Akismet 会用到
SITE_URL=https://blog.example.com

# "今日访问"按哪个时区算
TIMEZONE=Asia/Shanghai

# 访客 IP 取自哪个请求头：x-forwarded-for | x-real-ip | cf-connecting-ip | none
TRUST_PROXY=x-forwarded-for

# IP 哈希用的盐，留空则首次启动时自动生成并存进数据库
HASH_SALT=

# ---------- 留言审核 ----------

# auto：可疑的进审核队列，其余直接显示 | all：全部先审核 | off：除了垃圾都直接显示
MODERATION=auto

# 同一 IP 两次留言的最短间隔（秒）、每 24 小时最多几条
COMMENT_INTERVAL=30
COMMENT_DAILY_LIMIT=20

# 留言里超过几个链接就进审核队列
MAX_LINKS=1

# 不含汉字的留言进审核队列
REQUIRE_CJK=true

# 打开页面后不到几秒就提交，视为机器填写，进审核队列；0 关闭
MIN_FILL_SECONDS=3

# 违禁词，命中即判为垃圾，逗号分隔
FORBIDDEN_WORDS=

# 禁止留言的 IP，逗号分隔，可写前缀，如 203.0.113.
BLOCK_IPS=

# Akismet 反垃圾（https://akismet.com/），留空不用
AKISMET_KEY=

# 人机验证：turnstile | hcaptcha | recaptcha（v3），留空不用；前端会自动读取 site key
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ---------- 计数器 ----------

# 计数器起始值
COUNTER_OFFSET=0

# 同一访客多少秒内重复打开同一页不重复计数；0 = 每次刷新都算
COUNTER_DEDUPE_SECONDS=600

# 多少秒内有访问算"在线"
ONLINE_WINDOW_SECONDS=300

# 同一 IP 每分钟最多计数几次，0 不限
HIT_RATE_PER_MINUTE=120

# ---------- 通知 ----------

# 有新留言时 POST 一段 JSON 到这个地址（带 text / content 字段，可直接用 Slack、Discord 的 webhook），留空不用
NOTIFY_WEBHOOK=

# 服务器要通过 HTTP 代理访问外网（Akismet、人机验证、通知）时，设 HTTPS_PROXY 并打开这一项
# HTTPS_PROXY=http://proxy.example.com:7890
# NODE_USE_ENV_PROXY=1
